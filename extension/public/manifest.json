{
  "manifest_version": 3,
  "name": "Meeting Present for GitHub",
  "version": "0.1",
  "description": "Present Markdown files from eth-siplab-team repositories as slides.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://github.com/eth-siplab-team/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/eth-siplab-team/*"],
      "css": ["content.css"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
