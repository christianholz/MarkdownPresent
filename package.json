{
  "name": "mdpresent",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run build:site && pnpm run build:extension",
    "build:site": "vite build",
    "build:extension": "vite build --config vite.extension.config.js",
    "package": "./scripts/package-release.sh",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "dompurify": "^3.2.6",
    "highlight.js": "^11.12.0",
    "katex": "^0.16.22",
    "marked": "^15.0.12"
  },
  "devDependencies": {
    "vite": "^6.3.5",
    "vitest": "^3.1.4"
  }
}
